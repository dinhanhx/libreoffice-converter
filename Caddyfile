{
	admin off
}

:80 {
	# No limits for health and docs
	handle /health {
		reverse_proxy fastapi:8000
	}

	handle /docs {
		reverse_proxy fastapi:8000
	}

	handle /openapi.json {
		reverse_proxy fastapi:8000
	}

	# Rate limit and file size limit for legacy endpoints
	handle /docx2pdf {
		rate_limit {
			zone convert_zone {
				key    {remote_host}
				events 30
				window 1m
			}
		}

		request_body {
			max_size 50MB
		}

		reverse_proxy fastapi:8000
	}

	handle /convert {
		rate_limit {
			zone convert_zone {
				key    {remote_host}
				events 30
				window 1m
			}
		}

		request_body {
			max_size 50MB
		}

		reverse_proxy fastapi:8000
	}

	# Rate limit and file size limit for /convert/*
	handle /convert/* {
		rate_limit {
			zone convert_zone {
				key    {remote_host}
				events 30
				window 1m
			}
		}

		request_body {
			max_size 30MB
		}

		reverse_proxy fastapi:8000
	}
}
