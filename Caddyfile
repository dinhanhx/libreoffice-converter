{
	admin off
}

:80 {
	# No limits for health and docs
	handle /health {
		reverse_proxy fastapi:8000
	}

	handle /docs {
		reverse_proxy fastapi:8000
	}

	handle /openapi.json {
		reverse_proxy fastapi:8000
	}

	handle /static-offline-docs/* {
		reverse_proxy fastapi:8000
	}

	# File size limit for legacy endpoints
	handle /docx2pdf {
		request_body {
			max_size 50MB
		}

		reverse_proxy fastapi:8000
	}

	handle /convert {
		request_body {
			max_size 50MB
		}

		reverse_proxy fastapi:8000
	}

	# File size limit for /convert/*
	handle /convert/* {
		request_body {
			max_size 50MB
		}

		reverse_proxy fastapi:8000
	}
}
